Package: libhyprwire-unstable-dev
Section: libdevel
Architecture: any
Multi-Arch: same
Depends:
 libhyprwire3-unstable (= ${binary:Version}),
 ${misc:Depends},
 libffi-dev,
 libhyprutils-unstable-dev,
 libpugixml-dev,
Replaces: libhyprwire-dev
Conflicts: libhyprwire-dev
Provides: libhyprwire-dev (= 0.3.1)
Description: A fast and consistent wire protocol for IPC
 Hyprwire is a fast and consistent wire protocol, and its implementation.
 This is essentially a "method" for processes to talk to each other.
 This package includes the build-headers for using hyprwire-unstable in your own project.

